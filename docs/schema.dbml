// Physical SQLite schema exported from the existing SQL migration.
// UUID defaults are generated by Prisma, not SQLite.

Table ChatTurn {
  id text [pk, not null]
  userId text [not null]
  prompt text [not null]
  reply text [not null]
  createdAt datetime [not null, default: `CURRENT_TIMESTAMP`]
  expiresAt datetime [not null]
  indexes {
    (userId, createdAt)
    expiresAt
  }
}
Ref: ChatTurn.userId > User.id [delete: cascade, update: cascade]

Table User {
  id text [pk, not null]
  name text [not null]
  email text [not null, unique]
  passwordHash text [not null]
  role text [not null, default: 'USER']
  createdAt datetime [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt datetime [not null]
}

Table Profile {
  id text [pk, not null]
  userId text [not null, unique]
  avatarUrl text
  bio text
}

Table Recipe {
  id text [pk, not null]
  title text [not null]
  emoji text [not null, default: '🍽️']
  description text
  imageUrl text
  instructions text [not null]
  preparationMinutes integer [not null]
  servings integer [not null, default: 1]
  difficulty text [not null, default: 'EASY']
  calories real
  protein real
  fat real
  carbs real
  isPublished boolean [not null, default: false]
  authorId text
  createdAt datetime [not null, default: `CURRENT_TIMESTAMP`]
  updatedAt datetime [not null]
  indexes {
    (title)
  }
}

Table Ingredient {
  id text [pk, not null]
  name text [not null, unique]
  category text [not null]
  caloriesPer100g real
  proteinPer100g real
  fatPer100g real
  carbsPer100g real
}

Table RecipeIngredient {
  recipeId text [not null]
  ingredientId text [not null]
  quantity real
  unit text
  optional boolean [not null, default: false]
  indexes {
    (recipeId, ingredientId) [pk]
    (ingredientId)
  }
}

Table FridgeItem {
  id text [pk, not null]
  userId text [not null]
  ingredientId text [not null]
  quantity real
  unit text
  expiresAt datetime
  indexes {
    (userId, ingredientId) [unique]
  }
}

Table Favorite {
  userId text [not null]
  recipeId text [not null]
  createdAt datetime [not null, default: `CURRENT_TIMESTAMP`]
  indexes {
    (userId, recipeId) [pk]
  }
}

Table ShoppingListItem {
  id text [pk, not null]
  userId text [not null]
  ingredientId text [not null]
  quantity real
  unit text
  isPurchased boolean [not null, default: false]
  indexes {
    (userId, ingredientId) [unique]
  }
}

Ref: Profile.userId - User.id [delete: cascade, update: cascade]
Ref: Recipe.authorId > User.id [delete: set null, update: cascade]
Ref: RecipeIngredient.ingredientId > Ingredient.id [delete: restrict, update: cascade]
Ref: RecipeIngredient.recipeId > Recipe.id [delete: cascade, update: cascade]
Ref: FridgeItem.ingredientId > Ingredient.id [delete: restrict, update: cascade]
Ref: FridgeItem.userId > User.id [delete: cascade, update: cascade]
Ref: Favorite.recipeId > Recipe.id [delete: cascade, update: cascade]
Ref: Favorite.userId > User.id [delete: cascade, update: cascade]
Ref: ShoppingListItem.ingredientId > Ingredient.id [delete: restrict, update: cascade]
Ref: ShoppingListItem.userId > User.id [delete: cascade, update: cascade]
